# Copy to .env.local for local development, and set the same variables in
# your hosting provider (e.g. Vercel → Project → Settings → Environment Variables).
# Variables starting NEXT_PUBLIC_ reach the browser and must be safe to show;
# every other one stays on the server and must stay secret.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6.1-sol
REVIEW_MODEL=openai/gpt-6.1-sol
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional models and checks (defaults shown)
# STAGING_MODEL=openai/gpt-6-luna      # the guide's script for each lesson
# ENRICH_MODEL=openai/gpt-6-luna       # suggests "Go deeper" resources
# VERIFY_MODEL=                        # online fact check; defaults to OPENROUTER_MODEL
# VERIFY_SEARCH_ENGINE=exa
# VERIFY_FACTS=off                     # turns the online fact check off

# Billing with Paddle (merchant of record). Leave these unset to keep Wondersity free
# in beta: plan limits only apply once the three NEXT_PUBLIC_PADDLE_ values are set.
# NEXT_PUBLIC_PADDLE_ENV=sandbox                 # or production
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=               # Paddle → Developer tools → Authentication
# NEXT_PUBLIC_PADDLE_PRICE_MONTHLY=pri_...       # $19.99 / month
# NEXT_PUBLIC_PADDLE_PRICE_YEARLY=pri_...        # $119.99 / year
# PADDLE_API_KEY=                                # server API key (customer portal links)
# PADDLE_WEBHOOK_SECRET=                         # notification destination → /api/billing/webhook
# SUPABASE_SECRET_KEY=                           # lets the server record subscriptions and fill the shared plan cache

# Optional: the public address, used for share images (defaults to the Vercel production URL)
# NEXT_PUBLIC_SITE_URL=https://example.com
